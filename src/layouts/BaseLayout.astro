---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  noindex?: boolean;
  headContent?: string;
  softwareSourceCode?: {
    name: string;
    description: string;
    programmingLanguage: string;
    codeRepository: string;
    keywords: string[];
    runtimePlatform?: string;
  };
}

const {
  title,
  description = "Personal site of a tech enthusiast exploring the latest in web development and AI.",
  image = "/og-image.svg",
  canonicalURL,
  noindex = false,
  headContent,
  softwareSourceCode
} = Astro.props;

const siteUrl = 'https://zjq.me';
const fullUrl = canonicalURL || Astro.url?.href || siteUrl;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{Astro.locals.title || title}</title>
    <meta name="title" content={Astro.locals.title || title} />
    <meta name="description" content={description} />
    <meta name="author" content="Zhu Jiaqi" />
    <link rel="canonical" href={fullUrl} />
    
    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={Astro.locals.title || title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl).href} />
    <meta property="og:site_name" content="Zhu Jiaqi - zjq.me" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={Astro.locals.title || title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl).href} />
    
    <!-- Additional SEO -->
    <meta name="generator" content="Astro v6.0.2" />
    <link rel="alternate" type="application/rss+xml" title="My Personal Blog" href="https://zjq.me/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- JSON-LD: Person Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": "https://zjq.me/#person",
        "name": "Zhu Jiaqi",
        "url": "https://zjq.me",
        "image": "https://zjq.me/og-image.svg",
        "sameAs": [
          "https://github.com/zhujiaqi",
          "https://www.linkedin.com/in/zhujiaqi"
        ],
        "jobTitle": "Full-Stack Developer",
        "worksFor": {
          "@type": "Organization",
          "name": "Independent"
        },
        "alumniOf": {
          "@type": "Organization",
          "name": "University"
        },
        "knowsAbout": [
          "Distributed Systems",
          "Redis Internal Architectures",
          "Go Backend Engineering",
          "Python",
          "Full-Stack Development",
          "AI & LLM Research",
          "System Architecture",
          "API Design"
        ],
        "email": "mailto:zjq426@gmail.com"
      }
    </script>
  </head>
  <body>
    {softwareSourceCode && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareSourceCode",
        "name": softwareSourceCode.name,
        "description": softwareSourceCode.description,
        "programmingLanguage": {
          "@type": "ComputerLanguage",
          "name": softwareSourceCode.programmingLanguage
        },
        "codeRepository": softwareSourceCode.codeRepository,
        "runtimePlatform": softwareSourceCode.runtimePlatform,
        "keywords": softwareSourceCode.keywords.join(", "),
        "author": {
          "@type": "Person",
          "name": "Zhu Jiaqi",
          "url": "https://zjq.me"
        },
        "isAccessibleForFree": true,
        "codeSampleType": "open-source"
      })} />
    )}
  <body>
    <header>
      <nav>
        <a href="/" class="logo">zjq.me</a>
        <div class="nav-links">
          <a href="/">About</a>
          <a href="/blog/">Blog</a>
          <a href="https://bjcp.zjq.me/" target="_blank" rel="noopener noreferrer" title="BJCP 风格查询 / BJCP Styles">BJCP</a>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>&copy; {new Date().getFullYear()} · Built with <a href="https://astro.build">Astro</a> · <span data-visitor-count>—</span> visitors so far</p>
    </footer>
    
  <script is:inline src="/visitor.js" defer></script>
  </body>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --color-bg: #f4efe4;
    --color-bg-secondary: #ebe3d3;
    --color-text: #191510;
    --color-text-secondary: #5f574a;
    --color-text-muted: #6f6453;
    --color-accent: #b23a1b;
    --color-accent-hover: #8f2c12;
    --color-border: #d9cdb8;
    --dot-color: rgba(25, 21, 16, 0.09);
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    --font-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
    --font-mono: 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, Monaco, monospace;
    --space-xs: 0.25rem; --space-sm: 0.5rem; --space-md: 1rem; --space-lg: 1.5rem; --space-xl: 2rem; --space-2xl: 3rem;
    --container-max: 720px;
    --header-height: 4rem;
  }
  @media (prefers-color-scheme: dark) {
    :root { --color-bg: #14110c; --color-bg-secondary: #1d1812; --color-text: #f0e8da; --color-text-secondary: #b7ac99; --color-text-muted: #8a8071; --color-border: #352d21; --color-accent: #e0784a; --color-accent-hover: #f0946b; --dot-color: rgba(240, 232, 218, 0.07); }
  }
  html { font-size: 16px; }
  body { font-family: var(--font-sans); background: var(--color-bg); color: var(--color-text); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; }
  h1, h2, h3, h4, h5, h6 { line-height: 1.2; font-weight: 600; margin-bottom: var(--space-md); }
  h1 { font-size: 2.5rem; } h2 { font-size: 1.875rem; } h3 { font-size: 1.5rem; } h4 { font-size: 1.25rem; }
  p { margin-bottom: var(--space-md); }
  a { color: var(--color-accent); text-decoration: none; }
  a:hover { color: var(--color-accent-hover); text-decoration: underline; }
  header { background: var(--color-bg-secondary); border-bottom: 1px solid var(--color-border); position: sticky; top: 0; z-index: 100; height: var(--header-height); }
  nav { max-width: var(--container-max); margin: 0 auto; padding: 0 var(--space-lg); height: 100%; display: flex; align-items: center; gap: var(--space-lg); }
  .logo { font-weight: 700; font-size: 1.25rem; color: var(--color-text); }
  .nav-links { display: flex; gap: var(--space-lg); margin-left: auto; }
  .nav-links a { color: var(--color-text-secondary); font-size: 0.9375rem; }
  .nav-links a:hover { color: var(--color-accent); }
  main { flex: 1; max-width: var(--container-max); margin: 0 auto; padding: var(--space-2xl) var(--space-lg); width: 100%; }
  footer { background: var(--color-bg-secondary); border-top: 1px solid var(--color-border); padding: var(--space-lg); text-align: center; color: var(--color-text-muted); font-size: 0.875rem; }
  footer a { color: var(--color-text-muted); }
  footer a:hover { color: var(--color-accent); }

  /* ===== EDITORIAL MODERN THEME ===== */
  body { background-color: var(--color-bg); background-image: radial-gradient(var(--dot-color) 1px, transparent 1px); background-size: 24px 24px; background-attachment: fixed; }
  ::selection { background: var(--color-accent); color: var(--color-bg); }
  a { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--color-accent-hover); text-decoration: underline; }
  h1, h2, h3, h4, h5, h6 { font-family: var(--font-serif); font-weight: 500; letter-spacing: -0.02em; }
  h1 { font-size: clamp(2.6rem, 6vw, 3.9rem); line-height: 1.02; }
  h2 { font-size: clamp(1.55rem, 3vw, 2.1rem); }
  header { background: color-mix(in srgb, var(--color-bg) 90%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-bottom: 2px solid var(--color-text); height: auto; }
  nav { max-width: 880px; height: 64px; gap: 1rem; }
  .logo { font-family: var(--font-mono); font-size: 0.95rem; font-weight: 600; letter-spacing: -0.02em; }
  .nav-links { gap: 1.5rem; }
  .nav-links a { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary); text-decoration: none; padding-bottom: 2px; border-bottom: 1px solid transparent; }
  .nav-links a:hover { color: var(--color-text); border-color: var(--color-accent); text-decoration: none; }
  main { max-width: 880px; padding: 4rem 1.5rem 3rem; }
  footer { background: transparent; border-top: 2px solid var(--color-text); padding: 1.4rem 1.5rem; color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; }
  footer a { color: var(--color-text-muted); text-decoration: none; border-bottom: 1px solid var(--color-border); }
  footer a:hover { color: var(--color-accent); border-color: var(--color-accent); }
  :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

</style>
